{
  "expo": {
    "name": "MiTri",
    "slug": "mitri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Escudo_Nacional_de_España.png",
    "scheme": "mitri",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFD100",
        "foregroundImage": "./assets/images/Escudo_Nacional_de_España.png"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Escudo_Nacional_de_España.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Escudo_Nacional_de_España.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFD100",
          "dark": {
            "backgroundColor": "#002B49"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}